package provider

import (
	"fmt"
	"testing"

	"github.com/stretchr/testify/assert"
	"github.com/stretchr/testify/require"
)

func TestClusterArgsMerge(t *testing.T) {
	t.Parallel()

	args := testClusterArgsDefaultMerge(t, "test-cluster")

	assert.Equal(t, clusterArgsAPIVersion, args.APIVersion, "APIVersion should be set to default")
	assert.Equal(t, clusterArgsKind, args.Kind, "Kind should be set to default")
	assert.Equal(t, clusterArgsVersionChannel, args.Spec.K0s.VersionChannel, "VersionChannel should be set to default")
	assert.Equal(t, 9443, args.Spec.K0s.Config.Spec.API.K0sApiPort, "k0sApiPort should be set to default")

	mergeArgs := ClusterArgs{}
	k0sApiPort := 1234
	mergeArgs.Spec.K0s.Config.Spec.API.K0sApiPort = &k0sApiPort
	args = testClusterArgsDefaultMerge(t, "test-cluster", &mergeArgs)

	assert.Equal(t, clusterArgsAPIVersion, args.APIVersion, "APIVersion should be set to default")
	assert.Equal(t, clusterArgsKind, args.Kind, "Kind should be set to default")
	assert.Equal(t, clusterArgsVersionChannel, args.Spec.K0s.VersionChannel, "VersionChannel should be set to default")
	assert.Equal(t, 1234, args.Spec.K0s.Config.Spec.API.K0sApiPort, "k0sApiPort should be set to 1234")
}

func testClusterArgsDefaultMerge(t *testing.T, name string, mergeArgs ...*ClusterArgs) *ClusterArgs {
	args, err := ClusterArgsDefaults(name)
	require.NoError(t, err, "ClusterArgsDefaults should not return an error")

	for _, a := range mergeArgs {
		fmt.Println("merge")
		err := args.Merge(a)
		require.NoError(t, err, "Merge should not return an error")
	}

	return args
}
